{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role (student or instructor), tier, and details.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique user ID matching auth.uid" },
        "name": { "type": "string", "description": "Display name of the user" },
        "email": { "type": "string", "format": "email", "description": "Google email address" },
        "role": { "type": "string", "enum": ["student", "instructor"], "description": "User role: student or instructor" },
        "tier": { "type": "string", "enum": ["Core", "Extended"], "description": "Curriculum tier" },
        "targetGrade": { "type": "string", "description": "Target exam grade" },
        "examDate": { "type": "string", "description": "Scheduled exam date" },
        "enrolledClassIds": { "type": "array", "description": "List of class IDs joined by the student" },
        "createdAt": { "type": "string", "description": "Account creation timestamp" },
        "lastActive": { "type": "string", "description": "Last active timestamp" },
        "gold": { "type": "number", "description": "Earned study gold balance" },
        "wood": { "type": "number", "description": "Wood building material balance" },
        "brick": { "type": "number", "description": "Brick building material balance" },
        "metal": { "type": "number", "description": "Metal building material balance" },
        "avatar": { "type": "string", "description": "Equipped avatar skin ID" },
        "equippedSkin": { "type": "string", "description": "Equipped skin ID" },
        "inventory": { "type": "array", "description": "List of all owned item IDs" },
        "unlockedSkins": { "type": "array", "description": "List of unlocked avatar skin card IDs" }
      },
      "required": ["uid", "name", "email", "role"]
    },
    "InstructorInvite": {
      "title": "InstructorInvite",
      "description": "Invitation record granting instructor access to a specific email address.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email", "description": "Invited instructor Google email" },
        "invitedByUid": { "type": "string", "description": "UID of the inviting instructor" },
        "invitedByName": { "type": "string", "description": "Name of the inviting instructor" },
        "invitedByEmail": { "type": "string", "description": "Email of the inviting instructor" },
        "invitedAt": { "type": "string", "description": "Timestamp of invitation" },
        "status": { "type": "string", "enum": ["pending", "accepted"], "description": "Invite status" }
      },
      "required": ["email", "invitedByUid", "invitedAt", "status"]
    },
    "Class": {
      "title": "Class",
      "description": "A class created by an instructor with a specific join code.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique class identifier" },
        "classCode": { "type": "string", "description": "Unique alphanumeric join code (e.g. SCI-8492)" },
        "name": { "type": "string", "description": "Name of the class" },
        "subject": { "type": "string", "enum": ["all", "biology", "chemistry", "physics"], "description": "Subject focus" },
        "description": { "type": "string", "description": "Optional class description" },
        "instructorId": { "type": "string", "description": "UID of the instructor who created this class" },
        "instructorName": { "type": "string", "description": "Name of the creator instructor" },
        "instructorEmail": { "type": "string", "description": "Email of the creator instructor" },
        "createdAt": { "type": "string", "description": "Creation timestamp" },
        "studentCount": { "type": "number", "description": "Current number of enrolled students" },
        "sharedInstructorEmails": { "type": "array", "description": "List of co-instructor emails with shared access to this class" },
        "sharedInstructors": { "type": "array", "description": "Records of shared instructors and when they joined" }
      },
      "required": ["id", "classCode", "name", "instructorId", "instructorName", "createdAt"]
    },
    "ClassStudentEnrollment": {
      "title": "ClassStudentEnrollment",
      "description": "Enrollment record linking a student to a class and holding their progress snapshot.",
      "type": "object",
      "properties": {
        "studentId": { "type": "string", "description": "Student auth UID" },
        "name": { "type": "string", "description": "Student display name" },
        "email": { "type": "string", "description": "Student Google email" },
        "tier": { "type": "string", "description": "Student tier" },
        "joinedAt": { "type": "string", "description": "When the student joined the class" },
        "lastActive": { "type": "string", "description": "Timestamp of latest progress update" },
        "completedLessonsCount": { "type": "number", "description": "Number of completed lessons" },
        "quizScores": { "type": "object", "description": "Map of subject quiz scores" },
        "subtopicQuizScores": { "type": "object", "description": "Map of subtopic quiz scores" },
        "topicConfidence": { "type": "object", "description": "Confidence ratings 1-5 per topic" },
        "trafficLights": { "type": "object", "description": "Traffic light status per subtopic" },
        "weakTopics": { "type": "array", "description": "List of weak topic codes" },
        "totalQuizScore": { "type": "number", "description": "Cumulative total score across quizzes completed" },
        "badgesCount": { "type": "number", "description": "Total number of virtual medal badges unlocked" },
        "quizzesCompletedCount": { "type": "number", "description": "Number of quizzes taken" },
        "xp": { "type": "number", "description": "Aggregated experience points" },
        "streakDays": { "type": "number", "description": "Unbroken active study streak days" },
        "featuredBadgeId": { "type": "string", "description": "Identifier of the student's featured badge" }
      },
      "required": ["studentId", "name", "email", "joinedAt"]
    },
    "TestConnection": {
      "title": "TestConnection",
      "description": "Connection test document for health checks.",
      "type": "object",
      "properties": {
        "status": { "type": "string", "description": "Status text" }
      }
    },
    "Task": {
      "title": "Task",
      "description": "An assignment or task created by an instructor for a class or specific students.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique task identifier" },
        "classId": { "type": "string", "description": "Class identifier or 'all'" },
        "className": { "type": "string", "description": "Name of the target class" },
        "title": { "type": "string", "description": "Title of the assigned task" },
        "description": { "type": "string", "description": "Instructions or guidance for the task" },
        "type": { 
          "type": "string", 
          "enum": ["both", "slides_traffic_light", "practice_quiz", "exam_paper", "custom"], 
          "description": "Task type: both slides and quiz, slide reading with traffic light, quiz, past paper, or custom" 
        },
        "targetSubtopics": { "type": "array", "description": "List of target Cambridge subtopic codes" },
        "targetSubject": { "type": "string", "enum": ["all", "biology", "chemistry", "physics"], "description": "Subject area" },
        "targetStudentIds": { "type": "array", "description": "Optional list of student UIDs if assigned to individual students" },
        "dueDate": { "type": "string", "description": "ISO timestamp of the due date" },
        "instructorId": { "type": "string", "description": "UID of the creating instructor" },
        "instructorName": { "type": "string", "description": "Display name of the instructor" },
        "createdAt": { "type": "string", "description": "Creation timestamp" }
      },
      "required": ["id", "classId", "title", "type", "dueDate", "instructorId", "createdAt"]
    },
    "TaskSubmission": {
      "title": "TaskSubmission",
      "description": "Student progress and completion status for a specific task.",
      "type": "object",
      "properties": {
        "studentId": { "type": "string", "description": "Student UID" },
        "studentName": { "type": "string", "description": "Student display name" },
        "studentEmail": { "type": "string", "description": "Student email" },
        "status": { 
          "type": "string", 
          "enum": ["not_started", "incomplete", "completed"], 
          "description": "Completion state of the task" 
        },
        "completedAt": { "type": "string", "description": "Timestamp when completed" },
        "lastActivityAt": { "type": "string", "description": "Timestamp of most recent activity" },
        "quizScore": { "type": "number", "description": "Quiz score achieved if practice quiz" },
        "trafficLight": { "type": "string", "description": "Traffic light status achieved if slides task" },
        "notes": { "type": "string", "description": "Optional student or instructor note" }
      },
      "required": ["studentId", "status"]
    },
    "BattleEventConfig": {
      "title": "BattleEventConfig",
      "description": "Configuration for the scheduled Battle Royale event.",
      "type": "object",
      "properties": {
        "nextEventDate": { "type": "string", "description": "Scheduled ISO timestamp of the monthly event" },
        "title": { "type": "string", "description": "Title of the tournament event" },
        "description": { "type": "string", "description": "Brief event instructions" },
        "season": { "type": "number", "description": "Current tournament season" }
      }
    },
    "BattleEventState": {
      "title": "BattleEventState",
      "description": "Real-time state of the Battle Royale arena.",
      "type": "object",
      "properties": {
        "status": { "type": "string", "enum": ["LOBBY", "IN_PROGRESS", "ENDED"], "description": "Current battle lifecycle state" },
        "startedAt": { "type": "string", "description": "Timestamp when the battle started" },
        "stormRadius": { "type": "number", "description": "Current storm circle radius in arena units" },
        "stormCenter": { "type": "object", "description": "Storm center coordinate {x, y}" },
        "currentWinner": { "type": "object", "description": "Winning player summary" }
      }
    },
    "BattleLobbyPlayer": {
      "title": "BattleLobbyPlayer",
      "description": "Student waiting in the pre-game lobby.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Auth UID of the student" },
        "name": { "type": "string", "description": "Display name of student" },
        "avatar": { "type": "string", "description": "Equipped avatar skin ID" },
        "equippedWeapon": { "type": "string", "description": "Equipped weapon ID" },
        "wood": { "type": "number", "description": "Wood materials" },
        "brick": { "type": "number", "description": "Brick materials" },
        "metal": { "type": "number", "description": "Metal materials" },
        "isReady": { "type": "boolean", "description": "Readiness indicator" },
        "joinedAt": { "type": "string", "description": "Join timestamp" }
      },
      "required": ["uid", "name"]
    },
    "BattleArenaPlayer": {
      "title": "BattleArenaPlayer",
      "description": "Live player in the 2D arena.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Player UID" },
        "name": { "type": "string", "description": "Player display name" },
        "avatar": { "type": "string", "description": "Avatar skin ID" },
        "equippedWeapon": { "type": "string", "description": "Equipped weapon ID" },
        "x": { "type": "number", "description": "X position in arena" },
        "y": { "type": "number", "description": "Y position in arena" },
        "angle": { "type": "number", "description": "Facing angle in radians" },
        "hp": { "type": "number", "description": "Current HP (0-100)" },
        "maxHp": { "type": "number", "description": "Max HP" },
        "shield": { "type": "number", "description": "Current Shield (0-100)" },
        "maxShield": { "type": "number", "description": "Max Shield" },
        "wood": { "type": "number", "description": "Current Wood materials" },
        "brick": { "type": "number", "description": "Current Brick materials" },
        "metal": { "type": "number", "description": "Current Metal materials" },
        "isAlive": { "type": "boolean", "description": "Alive or eliminated" },
        "kills": { "type": "number", "description": "Eliminations in current match" }
      },
      "required": ["uid", "name", "hp", "isAlive"]
    },
    "BattleStructure": {
      "title": "BattleStructure",
      "description": "Constructed defense barrier placed by a student.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique structure ID" },
        "x": { "type": "number", "description": "X position in arena" },
        "y": { "type": "number", "description": "Y position in arena" },
        "type": { "type": "string", "enum": ["wood_wall", "brick_ramp", "metal_bunker"], "description": "Structure type" },
        "hp": { "type": "number", "description": "Current barrier health" },
        "maxHp": { "type": "number", "description": "Max barrier health" },
        "ownerId": { "type": "string", "description": "UID of builder" },
        "createdAt": { "type": "string", "description": "Build timestamp" }
      },
      "required": ["id", "x", "y", "type", "hp", "ownerId"]
    },
    "BattleCrate": {
      "title": "BattleCrate",
      "description": "Supply drop crate containing IGCSE science questions.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Crate ID" },
        "x": { "type": "number", "description": "X position" },
        "y": { "type": "number", "description": "Y position" },
        "isClaimed": { "type": "boolean", "description": "Whether crate has been opened" },
        "rewardType": { "type": "string", "enum": ["shield", "materials"], "description": "Reward type" }
      },
      "required": ["id", "x", "y", "isClaimed"]
    },
    "ModuleRewardClaim": {
      "title": "ModuleRewardClaim",
      "description": "Record of revision module completion rewards claimed by a student.",
      "type": "object",
      "properties": {
        "claimedAt": { "type": "string", "description": "Claim timestamp" },
        "wood": { "type": "number", "description": "Wood awarded" },
        "brick": { "type": "number", "description": "Brick awarded" },
        "metal": { "type": "number", "description": "Metal awarded" },
        "xp": { "type": "number", "description": "XP awarded" },
        "gold": { "type": "number", "description": "Gold awarded" }
      },
      "required": ["claimedAt"]
    }
  },
  "firestore": {
    "/test/{docId}": {
      "schema": { "$ref": "#/entities/TestConnection" },
      "description": "Connection test documents for health checks."
    },
    "/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/Task" },
      "description": "Tasks set by instructors for classes or individual students."
    },
    "/tasks/{taskId}/submissions/{studentId}": {
      "schema": { "$ref": "#/entities/TaskSubmission" },
      "description": "Student progress tracking and submission status per task."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Stores user profiles with assigned roles (student or instructor)."
    },
    "/users/{userId}/completedModules/{moduleId}": {
      "schema": { "$ref": "#/entities/ModuleRewardClaim" },
      "description": "Anti-farming records for claimed lesson slide revision rewards."
    },
    "/instructor_invites/{inviteId}": {
      "schema": { "$ref": "#/entities/InstructorInvite" },
      "description": "Records instructor invitations issued by existing instructors."
    },
    "/classes/{classId}": {
      "schema": { "$ref": "#/entities/Class" },
      "description": "Classes created by instructors with class codes."
    },
    "/classes/{classId}/students/{studentId}": {
      "schema": { "$ref": "#/entities/ClassStudentEnrollment" },
      "description": "Students enrolled in a specific class and their progress tracked by the instructor."
    },
    "/battleEvent/config": {
      "schema": { "$ref": "#/entities/BattleEventConfig" },
      "description": "Tournament countdown and schedule configuration."
    },
    "/battleEvent/state": {
      "schema": { "$ref": "#/entities/BattleEventState" },
      "description": "Real-time state of the Battle Royale match."
    },
    "/battleEvent/lobby/{uid}": {
      "schema": { "$ref": "#/entities/BattleLobbyPlayer" },
      "description": "Students waiting in the pre-game match lobby."
    },
    "/battleEvent/players/{uid}": {
      "schema": { "$ref": "#/entities/BattleArenaPlayer" },
      "description": "Real-time coordinates, health, and loadouts of arena combatants."
    },
    "/battleEvent/structures/{structureId}": {
      "schema": { "$ref": "#/entities/BattleStructure" },
      "description": "Walls, ramps, and metal bunkers built during the match."
    },
    "/battleEvent/crates/{crateId}": {
      "schema": { "$ref": "#/entities/BattleCrate" },
      "description": "Science supply crates dropped in the arena."
    }
  }
}
