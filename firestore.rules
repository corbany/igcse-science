rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isClassInstructor(classId) {
      return isAuthenticated() && (
        get(/databases/$(database)/documents/classes/$(classId)).data.instructorId == request.auth.uid ||
        get(/databases/$(database)/documents/classes/$(classId)).data.instructorEmail == request.auth.token.email ||
        request.auth.token.email in get(/databases/$(database)/documents/classes/$(classId)).data.sharedInstructorEmails ||
        request.auth.token.email == 'corbanb@gisboyshigh.net'
      );
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }

    // User profiles & subcollections (including completedModules anti-farming records)
    match /users/{userId} {
      allow read, write: if true;

      match /{subcollection=**} {
        allow read, write: if true;
      }
    }
    
    // Gamified Battle Royale Tournament Events
    match /battleEvent/{docId} {
      allow read, write: if true;

      match /{subcollection=**} {
        allow read, write: if true;
      }
    }
    
    // Instructor invites
    match /instructor_invites/{inviteId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    // Classes created by instructors
    match /classes/{classId} {
      allow read: if true;
      allow create: if isAuthenticated() || true;
      allow update, delete: if true;
      
      // Enrolled students in a class
      match /students/{studentId} {
        allow read: if true;
        allow create, update: if true;
        allow delete: if true;
      }
    }

    // Tasks and homework assignments
    match /tasks/{taskId} {
      allow read: if true;
      allow create, update, delete: if true;

      // Student progress submissions per task
      match /submissions/{studentId} {
        allow read: if true;
        allow create, update, delete: if true;
      }
    }

    // In-app notifications
    match /notifications/{notificationId} {
      allow read, write: if true;
    }
  }
}
